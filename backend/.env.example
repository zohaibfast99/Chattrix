# ── Server ────────────────────────────────────────────────
# Must stay 5001: frontend/src/lib/axios.js hardcodes http://localhost:5001/api
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/chattrix
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/chattrix?retryWrites=true&w=majority
MONGODB_URI=

# ── Auth ──────────────────────────────────────────────────
# Generated for you. Rotate it and every existing login cookie becomes invalid.
JWT_SECRET=

# ── Cloudinary (image uploads: profile pics + image messages) ──
# cloudinary.com → Dashboard → "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Groq (the built-in Chattrix AI assistant) ──────────────
# console.groq.com → API Keys. Server-side only; never exposed to the browser.
GROQ_API_KEY=
